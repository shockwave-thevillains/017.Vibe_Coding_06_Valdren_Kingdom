          },
          {
            "x": 13,
            "z": 19.6,
            "wait": 7,
            "face": -1.5708
          }
        ]
      },
      "look": {
        "skin": "#c99878",
        "hair": "#4a2e1a",
        "hairStyle": "short",
        "beard": "short",
        "stubble": false,
        "eyes": "#6a4a2a",
        "age": 0.25,
        "tunic": "#6a2240",
        "sleeves": "#a8781e",
        "trousers": "#2e3a5a",
        "boots": "#2a1e16",
        "belt": "#3a2414",
        "pouch": "#8a5a2e",
        "trim": "#d4a640",
        "cloak": "#2a4a3a",
        "cloakTrim": "#d4a640"
      },
      "outfit": {
        "hat": "#2f4a2c"
      },
      "dialogue": {
        "start": [
          {
            "if": [
              "met_tobias"
            ],
            "node": "again"
          },
          {
            "node": "greet"
          }
        ],
        "nodes": {
          "greet": {
            "text": "Cloth from the coast, pepper from beyond the sea, needles finer than a lady's eyelash! Ah, a new face. Tobias Fenn, at your service.",
            "choices": [
              {
                "text": "You're not from Valdren?",
                "next": "outsider"
              },
              {
                "text": "How's trade?",
                "next": "trade"
              },
              {
                "text": "Just looking."
              }
            ]
          },
          "again": {
            "text": "Back for pepper? No? Then for gossip, which is cheaper.",
            "choices": [
              {
                "text": "Tell me about the bridge stone.",
                "next": "bridge"
              },
              {
                "text": "Was the bargain ever broken?",
                "next": "kept",
                "if": [
                  "heard_bread_oath"
                ]
              },
              {
                "text": "Nothing today, Tobias."
              }
            ]
          },
          "outsider": {
            "text": "Saltmere, three weeks downriver. I come up every spring. Valdren's bridge is the only crossing for forty miles, so sooner or later everyone comes through here.",
            "choices": [
              {
                "text": "The bridge matters that much?",
                "next": "bridge"
              },
              {
                "text": "How's trade?",
                "next": "trade"
              },
              {
                "text": "Safe travels."
              }
            ]
          },
          "trade": {
            "text": "Good, if you don't mind the king's tolls. Better than thirty years ago, my father would say. Back then grain sold for silver by the cup.",
            "choices": [
              {
                "text": "Why was grain so dear?",
                "next": "bridge"
              },
              {
                "text": "I'll leave you to it."
              }
            ]
          },
          "bridge": {
            "text": "The bridge is the whole kingdom! No bridge, no road, no market, no Valdren. There's a stone at its south end with Queen Aldra's oath on it. Merchants touch it for luck.",
            "choices": [
              {
                "text": "What does the oath say?",
                "next": "oath"
              },
              {
                "text": "I'll go and touch it myself."
              }
            ]
          },
          "oath": {
            "text": "‘Ponte et pane’: by bridge and by bread. The crown keeps the crossing open and the granary full, and in a hungry year the granary opens to all. That bargain is why the farmers swore to her.",
            "set": [
              "heard_bread_oath"
            ],
            "choices": [
              {
                "text": "And was the bargain kept?",
                "next": "kept"
              },
              {
                "text": "A fine bargain."
              }
            ]
          },
          "kept": {
            "text": "Ha! Ask the farmers about the Red Winter. Up and down the river they still say ‘tight as Harald's granary’. My father traded here that year. He said the castle had grain and the town had funerals.",
            "set": [
              "heard_red_winter"
            ],
            "leave": "Thank him and move on."
          }
        }
      }
    },
    {
      "id": "wynn",
      "name": "Wynn Hollis",
      "role": "Farmer",
      "position": {
