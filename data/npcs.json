          },
          {
            "x": -10.5,
            "z": 202,
            "wait": 0.3
          },
          {
            "x": -10.5,
            "z": 222,
            "wait": 0.3
          },
          {
            "x": -21.5,
            "z": 227,
            "wait": 12,
            "face": 0
          }
        ]
      },
      "look": {
        "female": true,
        "skin": "#c48a64",
        "hair": "#8a7f74",
        "hairStyle": "bun",
        "eyes": "#4a5a3a",
        "lips": "#a8564c",
        "age": 0.5,
        "tunic": "#7a5a3a",
        "sleeves": "#d8ccb0",
        "skirt": "robe",
        "trim": "#5a4028",
        "belt": "#3a2a1a",
        "pouch": "#6a4a2e",
        "boots": "#3a2a1e",
        "cloak": null
      },
      "outfit": {
        "strawHat": true,
        "apron": "#cfc2a2",
        "hoe": true
      },
      "dialogue": {
        "start": [
          {
            "if": [
              "met_wynn"
            ],
            "node": "again"
          },
          {
            "node": "greet"
          }
        ],
        "nodes": {
          "greet": {
            "text": "Mind the furrows, they're new. If you're from the castle, the tithe's paid. If you're not, well, hello.",
            "choices": [
              {
                "text": "I'm not from the castle.",
                "next": "notcastle"
              },
              {
                "text": "Good harvest this year?",
                "next": "harvest"
              },
              {
                "text": "Sorry to disturb you."
              }
            ]
          },
          "again": {
            "text": "Back again? Grab a hoe or grab a seat.",
            "choices": [
              {
                "text": "Tell me about the Red Winter.",
                "next": "redwinter"
              },
              {
                "text": "Tell me about Prince Edmund.",
                "next": "edmund",
                "if": [
                  "heard_carts",
                  "!lore_letter"
                ]
              },
              {
                "text": "I read your mother's letter.",
                "next": "letter",
                "if": [
                  "lore_letter"
                ]
              },
              {
                "text": "Just passing, Wynn."
              }
            ]
          },
          "letter": {
            "text": "She told me to burn it. I never could.” She leans on the hoe. “Then you know I was nineteen and foolish and brave, once. Keep it to yourself, or don't. I'm too old to be frightened of the castle now.",
            "set": [
              "heard_bread"
            ],
            "leave": "Leave her to the furrows."
          },
          "notcastle": {
            "text": "Then sit a moment; my knees want an excuse. Name's Wynn. My family has farmed this bank since before the bridge.",
            "choices": [
              {
                "text": "Do you remember the Red Winter?",
                "next": "redwinter"
              },
              {
                "text": "Good harvest this year?",
                "next": "harvest"
              },
              {
                "text": "I'll let you work."
              }
            ]
          },
          "harvest": {
            "text": "Good enough. Wheat's tall, barley's fat, and the mill's turning. I never complain about good years. I've seen the other kind.",
            "choices": [
              {
                "text": "The Red Winter?",
                "next": "redwinter"
              },
              {
                "text": "Long may it last."
              }
            ]
          },
          "redwinter": {
            "text": "I was nineteen. Blight in the summer, frost in the autumn, and by midwinter we were boiling bark. My little brother didn't see the spring. Nor did half the babes in the valley.",
            "set": [
              "heard_red_winter"
            ],
            "choices": [
              {
                "text": "Didn't the castle help?",
                "next": "castle"
              },
              {
                "text": "I'm sorry."
              }
            ]
          },
          "castle": {
            "text": "The castle shut its gates. Then one night, in the deep of winter, there were carts on the road. Grain carts, with the prince's own riders walking beside them.",
            "set": [
              "heard_carts"
            ],
            "choices": [
              {
                "text": "Prince Edmund?",
                "next": "edmund"
              },
              {
                "text": "Thank you for telling me."
              }
            ]
          },
          "edmund": {
            "text": "Edmund himself, his hands raw from the reins. He opened his father's granary without asking and gave it away sack by sack. Three nights later his tower was burning.",
            "set": [
              "heard_edmund",
              "heard_tower_fire"
            ],
            "choices": [
              {
                "text": "What happened to him?",
                "next": "after"
              },
              {
                "text": "Thank you, Wynn."
              }
            ]
          },
          "after": {
            "text": "The chronicles say he died.” She looks west, towards the forest. “I bake an extra loaf on Fridays. Old habit. Don't ask me who eats it.",
            "set": [
              "heard_bread"
            ],
            "leave": "Leave her to the furrows."
          }
        }
      }
    },
    {
      "id": "hermit",
      "name": "The Old Hermit",
      "role": "Hermit of the Greywatch",
      "position": {
