          }
        ]
      },
      "look": {
        "skin": "#c49577",
        "hair": "#6e6258",
        "hairStyle": "short",
        "beard": "short",
        "stubble": false,
        "eyes": "#4a5e72",
        "age": 0.55,
        "tunic": "#5a1c2a",
        "skirt": "robe",
        "trim": "#d4a640",
        "trousers": "#2a2230",
        "boots": "#2e2118",
        "belt": "#2a1a10",
        "pouch": null,
        "cloak": "#24356e",
        "cloakTrim": "#efeae0",
        "gloveL": "#1e1712"
      },
      "outfit": {
        "crown": true,
        "ermine": true
      },
      "dialogue": {
        "start": [
          {
            "if": [
              "edmund_confessed",
              "!told_king"
            ],
            "node": "news"
          },
          {
            "if": [
              "told_king"
            ],
            "node": "after"
          },
          {
            "if": [
              "met_king"
            ],
            "node": "again"
          },
          {
            "node": "greet"
          }
        ],
        "nodes": {
          "news": {
            "text": "You come back with a look I do not like. Speak.",
            "choices": [
              {
                "text": "Your brother is alive, Majesty. He lives at the Greywatch.",
                "next": "alive"
              },
              {
                "text": "It is nothing, Majesty."
              }
            ]
          },
          "alive": {
            "text": "You lie.” His gloved hand closes into a fist. “I saw that tower burn. I went into the fire after him and found nothing.",
            "choices": [
              {
                "text": "He crawled out through the cellar. Wynn Hollis found him on the west road.",
                "next": "cellar"
              },
              {
                "text": "Forgive me. I'll go."
              }
            ]
          },
          "cellar": {
            "text": "Nothing… because there was nothing to find.” He sits down heavily on the dais step. “Thirty-one years I have kept that door shut, because opening it meant saying what we did. Did he say anything of me?",
            "choices": [
              {
                "text": "He said he never blamed the boy.",
                "next": "forgive"
              },
              {
                "text": "He said the door can be opened now.",
                "next": "forgive"
              }
            ]
          },
          "forgive": {
            "text": "Then it will be opened. At first light, before the whole town, and the granary filled again as Aldra meant it. And then I will ride to the Greywatch myself.” He pulls off the glove and looks at the old scar. “By bridge and by bread, traveller. Thank you.",
            "set": [
              "told_king"
            ],
            "leave": "Bow, and leave the brothers their peace."
          },
          "after": {
            "text": "The smith is cutting the chains at dawn. I have not slept. I find I do not mind.",
            "choices": [
              {
                "text": "Will you go to the Greywatch?",
                "next": "ride"
              },
              {
                "text": "Good day, Majesty."
              }
            ]
          },
          "ride": {
            "text": "Tomorrow. Alone, without a crown. I owe him a winter's worth of bread and thirty-one years of apology, and I mean to start with the bread.",
            "leave": "Bow and withdraw."
          },
          "greet": {
            "text": "A traveller in my hall, unannounced. Few are so bold these days. Speak, and be brief.",
            "choices": [
              {
                "text": "Forgive me, Your Majesty. I came to see Valdren.",
                "next": "kingdom"
              },
              {
                "text": "Why do you wear only one glove?",
                "next": "glove"
              },
              {
                "text": "I will leave you in peace."
              }
            ]
          },
          "again": {
            "text": "You again. Ask what you came to ask.",
            "choices": [
              {
                "text": "Tell me of the Red Winter.",
                "next": "redwinter"
              },
              {
                "text": "About your brother, Prince Edmund…",
                "next": "edmund",
                "if": [
                  "heard_edmund"
                ]
              },
              {
                "text": "Why do you wear only one glove?",
                "next": "glove",
                "if": [
                  "!heard_edmund"
                ]
              },
              {
                "text": "Farewell, Majesty."
              }
            ]
          },
          "kingdom": {
            "text": "Then look well. Queen Aldra raised the bridge, my forefathers raised these walls, and I keep them standing. Three hundred and two years, and no army has ever crossed that river uninvited.",
            "choices": [
              {
                "text": "Who was Queen Aldra?",
                "next": "aldra"
              },
              {
                "text": "In the town they speak of a Red Winter.",
                "next": "redwinter"
              },
              {
                "text": "Thank you, Majesty."
              }
            ]
          },
          "aldra": {
            "text": "The founder. A ferryman's daughter who bridged the river and swore an oath on its first stone: ‘By bridge and by bread.’ It is woven into every banner in this hall, though few remember what it means.",
            "choices": [
              {
                "text": "What does it mean?",
                "next": "oath"
              },
              {
                "text": "Tell me of your father, King Harald.",
                "next": "harald"
              },
              {
                "text": "I have taken enough of your time."
              }
            ]
          },
          "oath": {
            "text": "That the crown holds the kingdom's grain in trust, and opens its stores to the hungry in a hard year. A fine promise. Promises are cheaper than granaries.",
            "set": [
              "heard_bread_oath"
            ],
            "choices": [
              {
                "text": "Was it kept in the Red Winter?",
                "next": "redwinter"
              },
              {
                "text": "I see. Farewell, Majesty."
              }
            ]
          },
          "redwinter": {
            "text": "The year the harvest rotted in the fields and the frost came early. I was young. My father held the realm together while lesser men panicked. That is all the chronicles need to say.",
            "set": [
              "heard_red_winter"
            ],
            "choices": [
              {
                "text": "Did he open the granary?",
                "next": "granary"
              },
              {
                "text": "Tell me about King Harald.",
                "next": "harald"
              },
              {
                "text": "Didn't you have a brother?",
                "next": "edmund",
                "if": [
                  "heard_edmund"
                ]
              }
            ]
          },
          "harald": {
            "text": "Harald the Steadfast. His statue stands in the market so that no one forgets who saved Valdren. He was a hard man. Hard winters need hard men.",
            "choices": [
              {
                "text": "Did he open the granary?",
                "next": "granary"
              },
              {
                "text": "Farewell, Majesty."
              }
            ]
          },
          "granary": {
            "text": "Open it? It was guarded. There were armies on the far bank and spies in every inn. A king who feeds his enemies loses his kingdom. We did what had to be done.",
            "choices": [
              {
                "text": "And the people who starved?",
                "next": "starved"
              },
              {
                "text": "And your brother? What did he do?",
                "next": "edmund",
                "if": [
                  "heard_edmund"
                ]
              },
              {
                "text": "I understand, Majesty."
              }
            ]
          },
          "starved": {
            "text": "You speak of things you did not see. I saw them. Leave it there, traveller.",
            "leave": "Bow and withdraw."
          },
          "glove": {
            "text": "A burn. An old one. A king's hand should not tremble in public, so I keep it covered. You are bold to ask.",
            "choices": [
              {
                "text": "How did it happen?",
                "next": "burn"
              },
              {
                "text": "Forgive me, Majesty."
              }
            ]
          },
          "burn": {
            "text": "A fire, thirty years ago, in a tower at the edge of the forest. I was too slow. We will not speak of it again.",
            "set": [
              "heard_tower_fire"
            ],
            "leave": "Bow and withdraw."
          },
          "edmund": {
            "text": "Edmund. My elder brother died in the Greywatch fire, killed by brigands. The chronicles say so. The stone in the chapel yard says so.",
            "choices": [
              {
                "text": "And what do you say?",
                "next": "edmund2"
              },
              {
                "text": "I'm sorry. I'll go."
              }
            ]
          },
          "edmund2": {
            "text": "I say he was braver than I was, and more foolish, and that the door he opened has stayed shut ever since.",
            "choices": [
              {
                "text": "Which door?",
                "next": "door"
              },
              {
                "text": "Then I will leave you to your memories."
              }
            ]
          },
          "door": {
            "text": "The door in the donjon. My father had it chained the morning after the fire, and I have never had it opened. Some doors are graves too. Go now.",
            "set": [
              "heard_sealed_door"
            ],
            "leave": "Bow and withdraw."
          }
        }
      }
    },
    {
      "id": "captain",
      "name": "Dame Isolde Varn",
      "role": "Captain of the Guard",
      "position": {
